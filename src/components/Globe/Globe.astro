<div class="globe-root">
  <div style="width: 100%; aspect-ratio: 1;">
    <canvas
      id="globe-canvas"
      style="width: 100%; height: 100%; cursor: grab; contain: layout paint size;"
    ></canvas>
  </div>
</div>

<style>
  .globe-root {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>

<script>
  import createGlobe from 'cobe';

  const canvas = document.getElementById('globe-canvas') as HTMLCanvasElement;
  let phi = 0;
  let width = canvas.offsetWidth;
  let pointerInteracting: number | null = null;
  let pointerInteractionMovement = 0;

  window.addEventListener('resize', () => {
    width = canvas.offsetWidth;
  });

  const globe = createGlobe(canvas, {
    devicePixelRatio: 2,
    width: width * 2,
    height: width * 2,
    phi: 0,
    theta: 0.25,
    dark: 1,
    diffuse: 1.2,
    mapSamples: 20000,
    mapBrightness: 8,
    baseColor: [0.15, 0.18, 0.25],
    markerColor: [0.376, 0.647, 0.98],
    glowColor: [0.08, 0.15, 0.3],
    markers: [
      { location: [48.8566, 2.3522], size: 0.08 },
      { location: [40.7128, -74.006], size: 0.08 },
      { location: [35.6762, 139.6503], size: 0.08 },
      { location: [-33.8688, 151.2093], size: 0.08 },
      { location: [51.5074, -0.1278], size: 0.08 },
    ],
    onRender: (state) => {
      if (pointerInteracting === null) {
        phi += 0.003;
      }
      state.phi = phi + pointerInteractionMovement;
      state.width = width * 2;
      state.height = width * 2;
    },
  });

  // Stop drawing frames while the globe is off-screen
  new IntersectionObserver(([entry]) => {
    globe.toggle(entry.isIntersecting);
  }).observe(canvas);

  const releasePointer = () => {
    pointerInteracting = null;
    canvas.style.cursor = 'grab';
  };

  canvas.addEventListener('pointerdown', (e) => {
    pointerInteracting = e.clientX - pointerInteractionMovement;
    canvas.style.cursor = 'grabbing';
  });
  canvas.addEventListener('pointerup', releasePointer);
  canvas.addEventListener('pointerout', releasePointer);
  canvas.addEventListener('pointermove', (e) => {
    if (pointerInteracting !== null) {
      pointerInteractionMovement = (e.clientX - pointerInteracting) / 200;
    }
  });
</script>
