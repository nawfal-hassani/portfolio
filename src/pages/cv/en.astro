      .header {
        display: grid;
        grid-template-columns: 28mm 1fr;
        gap: 8mm;
        align-items: center;
        padding-bottom: 5mm;
        border-bottom: 1px solid var(--accent);
        margin-bottom: 5mm;
      }
      .photo {
        width: 28mm;
        height: 28mm;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid var(--accent);
      }
      .header-text h1 {
        font-family: 'Instrument Serif', Georgia, serif;
        font-size: 28pt;
        font-weight: 400;
        letter-spacing: 0;
        line-height: 1;
        margin: 0 0 4px;
        color: var(--ink);
      }
      .header-text .role {
        font-size: 10pt;
        color: var(--accent);
        font-weight: 600;
        margin: 0 0 2px;
      }
