        margin-bottom: 1.5mm;
      }
      .side > section:last-child,
      .main > section:last-child {
        margin-bottom: 0;
      }

      .side .profile-text {
        margin: 0;
        font-size: 8.6pt;
        color: var(--ink-soft);
        text-align: justify;
