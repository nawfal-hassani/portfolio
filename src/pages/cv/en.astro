        color: var(--ink-soft);
        margin: 0 0 6px;
        font-style: italic;
      }
      .contact-row {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 4px 14px;
        font-size: 8.4pt;
        color: var(--ink-soft);
      }
      .contact-row li {
        display: inline-flex;
        align-items: center;
        gap: 4px;
      }
      .contact-row svg {
        color: var(--accent);
        flex-shrink: 0;
      }
      .contact-row a {
        color: inherit;
        text-decoration: none;
      }

      .grid {
        display: grid;
        grid-template-columns: 62mm 1fr;
        gap: 7mm;
        position: relative;
      }
      .side {
        background: var(--paper);
        margin: -4mm -6mm -6mm -12mm;
        padding: 4mm 4mm 6mm 12mm;
        border-right: 1px solid var(--accent);
        display: flex;
        flex-direction: column;
      }

      section h2 {
        font-size: 9.5pt;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--accent);
        margin: 0 0 5px;
        padding-bottom: 3px;
        border-bottom: 1px solid var(--rule);
      }
      section.main > section > h2 {
        font-size: 11pt;
        border-bottom: 2px solid var(--accent);
        padding-bottom: 5px;
        margin-top: 7mm;
        margin-bottom: 4mm;
        letter-spacing: 0.14em;
      }
