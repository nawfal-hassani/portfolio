        padding-left: 14px;
        font-size: 8.8pt;
        color: var(--ink-soft);
      }
      .job ul li {
        margin-bottom: 1.5px;
      }
      .proj p {
        margin: 0;
        font-size: 8.8pt;
        color: var(--ink-soft);
        text-align: justify;
      }

      @page {
        size: A4;
        margin: 0;
      }

      @media print {
        html, body {
          background: var(--paper);
          margin: 0 !important;
          padding: 0 !important;
        }
        .print-btn { display: none; }
        .page {
          width: 210mm;
          height: 290mm;
          margin: 0 !important;
          box-shadow: none;
          padding: 6mm 12mm 4mm;
          page-break-after: avoid;
          overflow: hidden;
