        color: var(--ink-soft);
        padding: 2px 7px;
        border-radius: 10px;
        border: 1px solid var(--rule);
        white-space: nowrap;
      }
      .proj-head .badge.highlight {
        background: var(--gold);
        color: #fff;
        border-color: var(--gold);
        font-weight: 700;
        letter-spacing: 0.04em;
      }
      .job .sub, .proj .sub {
