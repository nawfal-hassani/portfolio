        background: var(--accent-soft);
        color: var(--accent);
        font-size: 7.4pt;
        font-weight: 600;
        padding: 1px 7px;
        border-radius: 4px;
        margin-left: 4px;
        vertical-align: middle;
        letter-spacing: 0.03em;
