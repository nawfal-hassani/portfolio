        background: var(--bg-soft);
        border: 1px solid var(--rule);
        border-radius: 4px;
        padding: 1px 5px 1px 4px;
        font-size: 7.4pt;
        color: var(--ink);
        font-weight: 500;
      }
      .skill-pill img {
        width: 11px;
        height: 11px;
        flex-shrink: 0;
      }

      .lang-list {
        list-style: none;
        margin: 0;
        padding: 0;
        font-size: 8.6pt;
      }
      .lang-list li {
        padding: 1.5px 0;
      }

      .engagement {
        font-size: 8.4pt;
        color: var(--ink-soft);
        margin: 0;
      }

      .qr-block {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 0;
        margin-top: auto;
        margin-bottom: auto;
        border: none;
        background: transparent;
        text-decoration: none;
        color: inherit;
      }
      .qr {
        width: 42mm;
        height: 42mm;
        max-width: 100%;
        flex-shrink: 0;
        display: block;
      }

      .job, .proj {
        margin-bottom: 1.8mm;
      }
      .job:last-child, .proj:last-child {
        margin-bottom: 0;
      }
      .job-head, .proj-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 6px;
      }
      .job-head h3, .proj-head h3 {
        font-size: 10pt;
        font-weight: 600;
        color: var(--ink);
        margin: 0;
      }
      .job-head .date {
        font-size: 8.2pt;
        color: var(--ink-mute);
        white-space: nowrap;
      }
      .chip {
        display: inline-block;
        background: var(--accent-soft);
        color: var(--accent);
        font-size: 7.4pt;
        font-weight: 600;
        padding: 1px 7px;
        border-radius: 4px;
        margin-inline-start: 4px;
        vertical-align: middle;
      }
      .proj-head .badge {
        font-size: 7.6pt;
        background: var(--bg-soft);
        color: var(--ink-soft);
        padding: 2px 7px;
        border-radius: 10px;
        border: 1px solid var(--rule);
        white-space: nowrap;
      }
      .proj-head .badge.highlight {
        background: var(--gold);
        color: #fff;
        border-color: var(--gold);
        font-weight: 700;
      }
      .job .sub, .proj .sub {
        font-size: 8.4pt;
        color: var(--ink-mute);
        margin: 1px 0 3px;
        font-weight: 500;
      }
      .job ul {
        margin: 2px 0 0;
        padding-inline-start: 14px;
        font-size: 8.8pt;
        color: var(--ink-soft);
      }
      .job ul li {
        margin-bottom: 1.5px;
      }
      .proj p {
        margin: 0;
        font-size: 8.8pt;
        color: var(--ink-soft);
        text-align: justify;
      }

      @page {
        size: A4;
        margin: 0;
      }

      @media print {
        html, body {
          background: var(--paper);
          margin: 0 !important;
          padding: 0 !important;
        }
        .print-btn { display: none; }
        .page {
          width: 210mm;
          height: 290mm;
          margin: 0 !important;
          box-shadow: none;
          padding: 6mm 12mm 10mm;
          page-break-after: avoid;
          overflow: hidden;
        }
        a { color: inherit; text-decoration: none; }
      }
    </style>
  </body>
</html>
