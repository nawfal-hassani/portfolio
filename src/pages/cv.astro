    <style>
      :root {
        --ink: #1a1a1a;
        --ink-soft: #3a3a3a;
        --ink-mute: #5b6478;
        --rule: #c9c1ad;
        --accent: #1a2440;
        --accent-soft: #e2dcc8;
        --bg-soft: #efe9d8;
        --paper: #f7f3e8;
        --gold: #b9892e;
      }

      * { box-sizing: border-box; }

      html, body {
        margin: 0;
        padding: 0;
        background: #d8d4c8;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        color: var(--ink);
        -webkit-font-smoothing: antialiased;
      }

      .print-btn {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 100;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: var(--accent);
        color: #fff;
        border: none;
        padding: 10px 16px;
        border-radius: 8px;
        font: 500 13px 'Inter', sans-serif;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.3);
        transition: transform 0.15s, box-shadow 0.15s;
      }
      .print-btn:hover {
        transform: translateY(-1px);
        box-shadow: 0 6px 16px rgba(37, 99, 235, 0.4);
      }

      .page {
        width: 210mm;
        height: 297mm;
        margin: 24px auto;
        background: var(--paper);
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
        padding: 8mm 12mm 6mm;
        font-size: 9pt;
        line-height: 1.35;
        overflow: hidden;
      }

      /* === HEADER === */
      .header {
        display: grid;
        grid-template-columns: 28mm 1fr;
        gap: 8mm;
        align-items: center;
        padding-bottom: 5mm;
        border-bottom: 1px solid var(--accent);
        margin-bottom: 5mm;
      }
      .photo {
        width: 28mm;
        height: 28mm;
        border-radius: 50%;
        object-fit: cover;
        border: 2px solid var(--accent);
      }
      .header-text h1 {
        font-family: 'Instrument Serif', Georgia, serif;
        font-size: 28pt;
        font-weight: 400;
        letter-spacing: 0;
        line-height: 1;
        margin: 0 0 4px;
        color: var(--ink);
      }
      .header-text .role {
        font-size: 10pt;
        color: var(--accent);
        font-weight: 600;
        margin: 0 0 2px;
      }
      .header-text .goal {
        font-size: 9pt;
        color: var(--ink-soft);
        margin: 0 0 6px;
        font-style: italic;
      }
      .contact-row {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 4px 14px;
        font-size: 8.4pt;
        color: var(--ink-soft);
      }
      .contact-row li {
        display: inline-flex;
        align-items: center;
        gap: 4px;
      }
      .contact-row svg {
        color: var(--accent);
        flex-shrink: 0;
      }
      .contact-row a {
        color: inherit;
        text-decoration: none;
      }

      /* === GRID === */
      .grid {
        display: grid;
        grid-template-columns: 62mm 1fr;
        gap: 7mm;
        position: relative;
      }
      .side {
        background: var(--paper);
        margin: -4mm -6mm -6mm -12mm;
        padding: 4mm 4mm 6mm 12mm;
        border-right: 1px solid var(--accent);
        display: flex;
        flex-direction: column;
        min-height: 235mm;
      }

      /* === SECTIONS === */
      section h2 {
        font-size: 9.5pt;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        color: var(--accent);
        margin: 0 0 2px;
        padding-bottom: 2px;
        border-bottom: 1px solid var(--rule);
      }
      section.main > section > h2 {
        font-size: 11pt;
        border-bottom: 2px solid var(--accent);
        padding-bottom: 5px;
        margin-top: 6mm;
        margin-bottom: 3.5mm;
        letter-spacing: 0.14em;
      }
      section.main > section:first-child > h2 {
        margin-top: 0;
      }

      .side > section,
      .main > section {
        margin-bottom: 2.2mm;
      }
      .side > section:last-child,
      .main > section:last-child {
        margin-bottom: 0;
      }

      .side .profile-text {
        margin: 0;
        font-size: 8.6pt;
        color: var(--ink-soft);
        text-align: justify;
      }

      .entry {
        margin-bottom: 1.5mm;
      }
      .entry:last-child { margin-bottom: 0; }
      .entry h3 {
        font-size: 9.2pt;
        font-weight: 600;
        color: var(--ink);
        margin: 0;
      }
      .entry .sub {
        font-size: 8.4pt;
        color: var(--ink-soft);
        margin: 1px 0;
      }
      .entry .date {
        font-size: 8pt;
        color: var(--ink-mute);
        margin: 0;
      }

      .skill-cat {
        font-size: 8.2pt;
        font-weight: 600;
        color: var(--ink);
        margin: 4px 0 2px;
        text-transform: none;
        letter-spacing: 0;
      }
      .skills {
        font-size: 8.4pt;
        color: var(--ink-soft);
        margin: 0;
      }
      .skill-row {
        display: flex;
        flex-wrap: wrap;
        gap: 3px 4px;
      }
      .skill-pill {
        display: inline-flex;
        align-items: center;
        gap: 3px;
        background: var(--bg-soft);
        border: 1px solid var(--rule);
        border-radius: 4px;
        padding: 1px 5px 1px 4px;
        font-size: 7.4pt;
        color: var(--ink);
        font-weight: 500;
      }
      .skill-pill img {
        width: 11px;
        height: 11px;
        flex-shrink: 0;
      }

      .lang-list {
        list-style: none;
        margin: 0;
        padding: 0;
        font-size: 8.6pt;
      }
      .lang-list li {
        padding: 1.5px 0;
      }

      .engagement {
        font-size: 8.4pt;
        color: var(--ink-soft);
        margin: 0;
      }

      .qr-block {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 0;
        margin-top: auto;
        margin-bottom: auto;
        border: none;
        background: transparent;
        text-decoration: none;
        color: inherit;
      }
      .qr {
        width: 50mm;
        height: 50mm;
        max-width: 100%;
        flex-shrink: 0;
        display: block;
      }
      .qr-meta {
        display: flex;
        flex-direction: column;
        gap: 1px;
        font-size: 7.8pt;
      }
      .qr-label {
        font-size: 7pt;
        color: var(--ink-mute);
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-weight: 600;
      }
      .qr-url {
        font-size: 9.5pt;
        color: var(--ink);
        font-weight: 700;
        font-family: ui-monospace, 'JetBrains Mono', Menlo, monospace;
      }
      .qr-sub {
        font-size: 7.4pt;
        color: var(--ink-soft);
        font-style: italic;
      }

      /* === MAIN === */
      .job, .proj {
        margin-bottom: 1.2mm;
      }
      .job:last-child, .proj:last-child {
        margin-bottom: 0;
      }
      .job-head, .proj-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 6px;
      }
      .job-head h3, .proj-head h3 {
        font-size: 10pt;
        font-weight: 600;
        color: var(--ink);
        margin: 0;
      }
      .job-head .date {
        font-size: 8.2pt;
        color: var(--ink-mute);
        white-space: nowrap;
      }
      .chip {
        display: inline-block;
        background: var(--accent-soft);
        color: var(--accent);
        font-size: 7.4pt;
        font-weight: 600;
        padding: 1px 7px;
        border-radius: 4px;
        margin-left: 4px;
        vertical-align: middle;
        letter-spacing: 0.03em;
      }
      .proj-head .badge {
        font-size: 7.6pt;
        background: var(--bg-soft);
        color: var(--ink-soft);
        padding: 2px 7px;
        border-radius: 10px;
        border: 1px solid var(--rule);
        white-space: nowrap;
      }
      .proj-head .badge.highlight {
        background: var(--gold);
        color: #fff;
        border-color: var(--gold);
        font-weight: 700;
        letter-spacing: 0.04em;
      }
      .job .sub, .proj .sub {
        font-size: 8.4pt;
        color: var(--ink-mute);
        margin: 1px 0 3px;
        font-weight: 500;
      }
      .job ul {
        margin: 2px 0 0;
        padding-left: 14px;
        font-size: 8.8pt;
        color: var(--ink-soft);
      }
      .job ul li {
        margin-bottom: 1.5px;
      }
      .proj p {
        margin: 0;
        font-size: 8.8pt;
        color: var(--ink-soft);
        text-align: justify;
      }

      /* === PRINT === */
      @page {
        size: A4;
        margin: 0;
      }

      @media print {
        html, body {
          background: var(--paper);
          margin: 0 !important;
          padding: 0 !important;
        }
        .print-btn { display: none; }
        .page {
          width: 210mm;
          height: 290mm;
          margin: 0 !important;
          box-shadow: none;
          padding: 6mm 12mm 10mm;
          page-break-after: avoid;
          overflow: hidden;
        }
        a { color: inherit; text-decoration: none; }
      }
    </style>
  </body>
</html>
